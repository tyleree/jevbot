# jevbot environment - variable NAMES only (D29). Copy to `.env` (git-ignored), chmod 600, fill in the values.
# A missing, empty or whitespace-only value counts as ABSENT. Values are never written to TOML and never logged.
# These names are constants in src/jevbot/config.py; no other credential variable may be set (startup refuses).

# Data directory, outside the git repository, mode 700 (default: /home/tyler/jevbot-data)
JEVBOT_DATA=

# TypeSafe AI key for the Jev model. Absent => MockJev (decider.kind = "auto")
TYPESAFE_API_KEY=

# Alpaca PAPER credentials only (the key id starts with "PK"). There is no live-trading code path.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Optional: alert webhook. Receives a fixed message id and an exit code - never balances, positions or secrets
JEVBOT_ALERT_WEBHOOK=
